<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bn_export" model="ir.module.category">
        <field name="name">Business Navigator Export</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_bn_export_user" model="res.groups">
        <field name="name">BN Export User</field>
        <field name="category_id" ref="module_category_bn_export"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_bn_export_manager" model="res.groups">
        <field name="name">BN Export Manager</field>
        <field name="category_id" ref="module_category_bn_export"/>
        <field name="implied_ids" eval="[(4, ref('group_bn_export_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company record rules: restrict batch/file access to the
         user's allowed companies (spec §18.2). -->
    <record id="rule_bn_export_batch_company" model="ir.rule">
        <field name="name">BN Export Batch: multi-company</field>
        <field name="model_id" ref="model_business_navigator_export_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bn_export_user'))]"/>
    </record>

    <record id="rule_bn_export_file_company" model="ir.rule">
        <field name="name">BN Export File: multi-company</field>
        <field name="model_id" ref="model_business_navigator_export_file"/>
        <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_bn_export_user'))]"/>
    </record>
</odoo>
