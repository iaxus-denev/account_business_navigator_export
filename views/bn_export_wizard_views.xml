<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bn_export_wizard_form" model="ir.ui.view">
        <field name="name">business.navigator.export.wizard.form</field>
        <field name="model">business.navigator.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Business Navigator Export">
                <group>
                    <group>
                        <field name="company_id"
                               domain="[('id', 'in', allowed_company_ids)]"
                               options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="export_sales_20"/>
                        <field name="export_sales_9"/>
                        <field name="export_purchases"/>
                        <field name="include_zero_value_lines"/>
                        <field name="run_validation_only"/>
                    </group>
                </group>
                <group>
                    <field name="note" placeholder="Вътрешна бележка..."/>
                </group>
                <group string="Резултат" invisible="state == 'draft'">
                    <field name="state" invisible="1"/>
                    <field name="error_count" invisible="1"/>
                    <field name="warning_count" invisible="1"/>
                    <field name="result_summary" readonly="1" nolabel="1"
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_validate" type="object"
                            string="Провери (Validate)" class="btn-secondary"/>
                    <button name="action_generate" type="object"
                            string="Генерирай (Generate)" class="btn-primary"
                            invisible="run_validation_only == True"/>
                    <button string="Затвори" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bn_export_wizard" model="ir.actions.act_window">
        <field name="name">Business Navigator Export</field>
        <field name="res_model">business.navigator.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
