<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bn_export" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bn.export</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Business Navigator Export"
                       id="bn_export_setting_container"
                       groups="account_business_navigator_export.group_bn_export_manager">
                    <setting id="bn_export_taxes_setting"
                             help="Данъци, които класифицират ред от продажба към съответния BN файл">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="bn_sales_20_tax_ids" string="Продажби 20% данъци"
                                       class="col-lg-3 o_light_label"/>
                                <field name="bn_sales_20_tax_ids" widget="many2many_tags"
                                       domain="[('type_tax_use', '=', 'sale')]"/>
                            </div>
                            <div class="row">
                                <label for="bn_sales_9_tax_ids" string="Продажби 9% данъци"
                                       class="col-lg-3 o_light_label"/>
                                <field name="bn_sales_9_tax_ids" widget="many2many_tags"
                                       domain="[('type_tax_use', '=', 'sale')]"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="bn_export_advance_setting"
                             help="Код на продукт, който маркира ред като авансово плащане">
                        <field name="bn_advance_product_code"/>
                    </setting>
                    <setting id="bn_export_flag_setting"
                             help="Стойност на последната колона (13) във всеки експортиран ред">
                        <field name="bn_last_flag"/>
                    </setting>
                    <setting id="bn_export_filenames_setting"
                             help="Представки за имената на генерираните файлове">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="bn_sales_20_filename_prefix" class="col-lg-3 o_light_label"/>
                                <field name="bn_sales_20_filename_prefix"/>
                            </div>
                            <div class="row">
                                <label for="bn_sales_9_filename_prefix" class="col-lg-3 o_light_label"/>
                                <field name="bn_sales_9_filename_prefix"/>
                            </div>
                            <div class="row">
                                <label for="bn_purchase_filename_prefix" class="col-lg-3 o_light_label"/>
                                <field name="bn_purchase_filename_prefix"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
